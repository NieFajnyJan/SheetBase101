# Copy this file to .env (same folder as manage.py) and fill in the values.
# .env is git-ignored – never commit real secrets.

# Django secret key – generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Google login – from Google Cloud Console → Google Auth Platform → Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dex login (OpenID Connect) – must match the staticClient in Dex's config
DEX_CLIENT_ID=
DEX_CLIENT_SECRET=
DEX_SERVER_URL=http://127.0.0.1:5556/dex
